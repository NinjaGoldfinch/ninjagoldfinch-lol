# Base URL of riot-proxy. Required; there is no shared dev instance, so this
# points at one you run yourself. Tests use the mock proxy instead.
PROXY_URL=http://127.0.0.1:8080

# riot-proxy read-scope consumer key. Optional in development (a local
# riot-proxy can run with auth disabled); required when NODE_ENV=production.
PROXY_KEY=

# CommunityDragon, for data riot-proxy does not mirror (stat shard names).
# Optional; defaults to https://raw.communitydragon.org.
CDRAGON_URL=

# Public origin of the site, for form CSRF checks. Read from the environment
# by `vite build` only (ADR-014), never from this file: `just dev` does not
# need it. This file is also the template for the preview VM's deploy/.env,
# whose ORIGIN the Docker build reads.
ORIGIN=http://localhost:3000

# Listen address and port for the production server (`node build`).
# Production sets HOST=127.0.0.1 behind its tunnel (ADR-038).
HOST=0.0.0.0
PORT=3000

# Site name. The only client-visible variable; never put a secret in PUBLIC_.
PUBLIC_SITE_NAME=ninjagoldfinch.lol
