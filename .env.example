# Base URL of riot-proxy. Required; there is no shared dev instance, so this
# points at one you run yourself. Tests use the mock proxy instead.
PROXY_URL=http://127.0.0.1:8080

# riot-proxy read-scope consumer key. Optional in development (a local
# riot-proxy can run with auth disabled); required when NODE_ENV=production.
PROXY_KEY=

# CommunityDragon, for data riot-proxy does not mirror (stat shard names).
# Optional; defaults to https://raw.communitydragon.org.
CDRAGON_URL=

# GET /api/status (ADR-062). A bearer token of at least 16 characters, secret
# like PROXY_KEY: `openssl rand -hex 32`. Optional; without it only a local
# request may read the status. A request through Cloudflare always needs it.
STATUS_TOKEN=

# CIDRs, besides loopback, that may read /api/status without the token, such
# as 10.0.0.0/8. Optional and empty by default.
STATUS_ALLOW_CIDR=

# Seconds between the background status checks. Optional; 30 by default.
STATUS_CHECK_INTERVAL_S=

# URL that state-change events are POSTed to (ADR-063): proxy_unreachable,
# proxy_recovered and deployed. Optional; without it no events are sent. No
# username or password in it (refused at start-up); a receiver's token goes in
# the path or the query string, and the URL is then a secret like PROXY_KEY.
EVENTS_URL=

# Writable directory where each start records its version, so the next start
# can tell a deploy (the deployed event), and where a raised proxy_unreachable
# is kept across restarts. systemd sets it from the unit's StateDirectory=.
# Optional; without it no deployed event is sent.
STATE_DIRECTORY=

# Public origin of the site, for form CSRF checks. Read from the environment
# by `vite build` only (ADR-014), never from this file: `just dev` does not
# need it. This file is also the template for the preview VM's deploy/.env,
# whose ORIGIN the Docker build reads.
ORIGIN=http://localhost:3000

# Listen address and port for the production server (`node build`).
# Production sets HOST=127.0.0.1 behind its tunnel (ADR-038).
HOST=0.0.0.0
PORT=3000

# Site name. The only client-visible variable; never put a secret in PUBLIC_.
PUBLIC_SITE_NAME=ninjagoldfinch.lol
