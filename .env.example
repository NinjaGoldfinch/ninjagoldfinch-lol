# Base URL of riot-proxy. The default is the LAN dev instance.
PROXY_URL=http://192.168.68.46:8080

# riot-proxy read-scope consumer key. Optional in development (the dev
# instance runs with auth disabled); required when NODE_ENV=production.
PROXY_KEY=

# Public origin of the site, used at build time (the Docker build reads it from
# deploy/.env) for form CSRF checks. Not needed for `just dev`.
ORIGIN=http://localhost:3000

# Listen port for the production server.
PORT=3000

# Site name. The only client-visible variable; never put a secret in PUBLIC_.
PUBLIC_SITE_NAME=ninjagoldfinch.lol
